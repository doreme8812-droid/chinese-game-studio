# ===== 服务基础 =====
PORT=3000
# 开发/演示用密钥（仅沙箱模式校验签名用，生产请改复杂随机值并保密）
DEV_SECRET=dev-secret-change-me

# ===== 真实模式开关（填空即用沙箱；填齐即用真实支付宝/微信签约代扣）=====
# 以下留空 = 沙箱模式（本地演示 gating 闭环，无需任何商户密钥）
# 填齐对应渠道 = 真实模式（需在 server.js 的 /api/subscribe 与 /api/notify 内接 SDK）

# ---- 支付宝（签约代扣 / 周期扣款）----
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ---- 微信支付（委托代扣 / 支付分）----
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_API_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY=
# WECHAT_CERT_PATH=

# ---- 海外：PayPal（订阅 / Subscriptions）----
# 需要 PayPal 商业账号；在 https://developer.paypal.com 创建 App 拿 Client ID + Secret
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_ENV=sandbox        # sandbox（测试）或 live（生产）

# ---- 海外：Paddle（merchant of record 代售，无需你注册公司）----
# 在 https://paddle.com 注册卖家，拿到 Vendor/Client ID 与 Webhook 密钥
# PADDLE_VENDOR_ID=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=    # 用于校验 Paddle-Signature
# PADDLE_ENV=sandbox        # sandbox（测试）或 production（生产）
